<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dropCallout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Collapsed Cyber-Glass Pill -->
    <LinearLayout
        android:id="@+id/dropCollapsedPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_drop_pill_glass"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <View
            android:id="@+id/dropPillDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_drop_status_dot" />

        <TextView
            android:id="@+id/dropPillLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F4F4F8"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="14/60m · 1x" />

        <ImageView
            android:id="@+id/dropPillExpandIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/drops_expand_progress"
            android:src="@drawable/baseline_expand_more_black_24"
            app:tint="#C4B5FD" />
    </LinearLayout>

    <!-- Expanded Cyber-Glass Card -->
    <LinearLayout
        android:id="@+id/dropExpandedCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_drop_callout_glass"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/dropCalloutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dropImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/drops"
                android:scaleType="centerInside"
                tools:src="@drawable/ic_drops" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dropTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F4F4F8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Cyber Charm Drop" />

                <TextView
                    android:id="@+id/dropSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#C4B5FD"
                    android:textSize="11sp"
                    tools:text="14/60m (23%) · Drop 1/3" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/dropMinimize"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="@string/drops_minimize_progress"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_expand_less"
                app:tint="#B8B8C8" />

            <ImageButton
                android:id="@+id/dropClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="@string/drops_dismiss"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/baseline_close_black_36"
                app:tint="#B8B8C8" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/dropProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#26FFFFFF"
            android:progressTint="#9146FF"
            tools:progress="230" />

        <LinearLayout
            android:id="@+id/dropTargetRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dropCreditTarget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CBD5E1"
                android:textSize="10sp"
                tools:text="Crediting @streamer" />

            <TextView
                android:id="@+id/dropActionChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_drop_action_chip"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:textColor="#E9D5FF"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Details" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dropProofRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dropProofDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_drop_status_dot" />

            <TextView
                android:id="@+id/dropProofText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                tools:text="Counting 1x · #14 OK · 8s ago · Next 42s" />
        </LinearLayout>

        <TextView
            android:id="@+id/dropMetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="WS ✓ · ~46m left · Ends 5h"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/dropMultiviewPeersText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#93C5FD"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="All 4 counting · Views OK ✓ · Drops: streamer"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
