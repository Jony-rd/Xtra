<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55A855F7">
    <item>
        <layer-list>
            <!-- 3D Hardware Plinth Shadow -->
            <item
                android:top="2dp"
                android:left="1dp"
                android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#D9080212" />
                </shape>
            </item>

            <!-- Main Cyber-Glass Body -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="315"
                        android:endColor="#F50A0614"
                        android:centerColor="#F20D0818"
                        android:startColor="#EB1C1032"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#C084FC" />
                </shape>
            </item>

            <!-- Top Inner Glass Bevel Highlight -->
            <item
                android:bottom="3dp"
                android:left="1.5dp"
                android:right="1.5dp"
                android:top="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="11dp" />
                    <gradient
                        android:angle="270"
                        android:centerColor="#08FFFFFF"
                        android:endColor="#00000000"
                        android:startColor="#2CC084FC"
                        android:type="linear" />
                    <stroke
                        android:width="0.75dp"
                        android:color="#445B21B6" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
